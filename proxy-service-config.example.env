# Example config for Proxy-api.py / proxy_mcp.py — copy to
# proxy-service-config.env and replace the placeholder keys.
# The real file is gitignored on purpose: it holds live keys.
#
#   copy proxy-service-config.example.env proxy-service-config.env

PROXY_SERVICE_HOST=127.0.0.1
PROXY_SERVICE_API_PORT=1712
PROXY_SERVICE_TUNNEL_PORT=1909
# Generate long random values, e.g.:
#   venv\Scripts\python -c "import secrets; print(secrets.token_hex(16))"
PROXY_SERVICE_API_KEY=replace-with-a-long-random-hex
PROXY_SERVICE_TUNNEL_KEY=replace-with-a-long-random-hex
PROXY_SERVICE_TUNNEL_USER=proxy
PROXY_SERVICE_WARMUP=1
PROXY_SERVICE_LOG_REQUESTS=1
PROXY_SERVICE_OUTPUT_ROOT=output
PROXY_SERVICE_MAX_CANDIDATES=2000
PROXY_SERVICE_VERIFY_BATCH_SIZE=250
# Faster pool: parallel source fetches + proxy checks (default 120).
# PROXY_SERVICE_MAX_CONCURRENT=250
# Tag working proxies with the platforms they can reach ("" = disabled).
# PROXY_SERVICE_PLATFORM_PROBES=telegram,instagram,whatsapp

# Your own proxies (paid residential etc.), one per line.
# Optional '|CC' suffix pins the exit country, e.g. gate.provider.com:8080|SG
# PROXY_SERVICE_RESIDENTIAL_FILE=residential-proxies.txt

# --- Fetch routing (JA3-correct HTTP / own-IP direct route / unlock API) ---
# curl_cffi gives every pool+tunnel fetch a real Chrome TLS fingerprint.
# Use "auto" (aiohttp for pool, curl_cffi for direct) or "aiohttp" to revert.
PROXY_SERVICE_FETCH_CLIENT=curl_cffi
# PROXY_SERVICE_CURL_WORKERS=64
# PROXY_SERVICE_CURL_IMPERSONATE=chrome
# Own-IP direct route (route="direct" in /fetch): paced so the IP stays safe.
# PROXY_SERVICE_DIRECT_CLIENT=curl_cffi
# PROXY_SERVICE_DIRECT_CONCURRENCY=2
# PROXY_SERVICE_DIRECT_MIN_INTERVAL=1.0
# External anti-block API (ScraperAPI/ZenRows/Scrape.do free tiers work):
# PROXY_SERVICE_UNLOCK_URL_TEMPLATE=http://api.scraperapi.com?api_key={key}&url={url}
# PROXY_SERVICE_UNLOCK_API_KEY=
# Hosts auto-routed via the unlock API when route=auto:
# PROXY_SERVICE_UNLOCK_HOSTS=meesho.com,etsy.com
